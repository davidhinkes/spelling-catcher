{
  "manifest_version": 3,
  "name": "Spelling Catcher",
  "version": "0.2.0",
  "description": "Learns the words you misspell and then fix, and keeps a running list in a Google Sheet in your Drive.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://sheets.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "151987373256-ronm53mv90j5tp9btda2pfdf2ra250ab.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spelling Catcher"
  }
}
